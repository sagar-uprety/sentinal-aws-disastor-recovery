# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Drill event log written by scripts/simulate-disaster.sh and failover.sh;
# regenerated fresh each drill, not source.
drill-events.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json
!terraform/environments/bootstrap/terraform.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore tfplan files (plan output of terraform plan -out=tfplan)
*.tfplan

# Module-level lock files are validation-only side effects of pre-commit's
# per-module terraform init; only environment roots commit a lock file.
terraform/modules/*/.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Go
app/sentinel
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of `go coverage`
*.out

# Go vendor
vendor/

# Node dependencies used to build static Tailwind CSS
app/node_modules/
app/static/uPlot.iife.min.js
app/static/uPlot.min.css

# Local env secrets
.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*.knp
*.bkp

# macOS
.DS_Store

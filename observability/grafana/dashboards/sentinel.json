{
  "title": "Sentinel Status",
  "uid": "sentinel",
  "panels": [
    {
      "title": "Checks per second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(sentinel_checks_total[1m])",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "title": "Response time (p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(sentinel_check_duration_milliseconds_bucket[1m]))",
          "legendFormat": "p99 {{target}}"
        }
      ]
    },
    {
      "title": "Target up/down",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sentinel_target_up",
          "legendFormat": "{{target}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": []
        }
      }
    },
    {
      "title": "Avg response time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(sentinel_check_duration_milliseconds_sum[1m]) / rate(sentinel_check_duration_milliseconds_count[1m])",
          "legendFormat": "avg {{target}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s"
}

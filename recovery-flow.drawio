    <mxCell id="ttl3" value="FAILBACK - return operation to primary, reset topology" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="700" width="700" height="24" as="geometry"/></mxCell>
    <mxCell id="b1" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_FAILBACK_SNAPSHOT=YES&lt;/font&gt;&lt;br&gt;&lt;b&gt;failback.sh snapshot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Snapshot the active secondary writer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="b2" value="&lt;font style=&quot;font-size:9.5px;color:#6D28D9&quot;&gt;-f confirm=true -f failback_snapshot_id=...&lt;/font&gt;&lt;br&gt;&lt;b&gt;recovery.yml failback-prepare&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Rebuild primary as secondary's replica&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#6D28D9;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="750" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="b3" value="&lt;b&gt;failback.sh verify-replica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Confirm replication + fresh lag&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="750" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="b4" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_FAILBACK_FREEZE=YES&lt;/font&gt;&lt;br&gt;&lt;b&gt;failback.sh freeze-writes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Scale secondary to 0, capture final write&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="750" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="b5" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_PRIMARY_PROMOTION=YES&lt;/font&gt;&lt;br&gt;&lt;b&gt;failback.sh promote-primary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Promote, Multi-AZ, fix password, start ECS 2/2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="750" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="b6" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_FAILBACK_READY=YES&lt;/font&gt;&lt;br&gt;&lt;b&gt;failback.sh ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Final go / no-go before traffic returns&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="960" width="200" height="90" as="geometry"/></mxCell>

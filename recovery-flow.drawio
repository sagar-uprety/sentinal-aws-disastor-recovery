    <mxCell id="b8" value="&lt;font style=&quot;font-size:9.5px;color:#6D28D9&quot;&gt;-f confirm=true&lt;/font&gt;&lt;br&gt;&lt;b&gt;recovery.yml failback-reset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Reconcile primary; rebuild secondary as replica&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#6D28D9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="960" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="b9" value="&lt;b&gt;failback.sh verify-reset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Confirm secondary at rest, fresh lag&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="960" width="200" height="90" as="geometry"/></mxCell>

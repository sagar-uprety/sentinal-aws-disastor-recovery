    <mxCell id="ttl2" value="FAILOVER - primary region down, activate secondary" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="310" width="600" height="24" as="geometry"/></mxCell>
    <mxCell id="f1" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_DISASTER=YES&lt;/font&gt;&lt;br&gt;&lt;b&gt;simulate-disaster.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Scale primary to 0, confirm 503 + 0 healthy&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="f3" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_FAILOVER=YES&lt;/font&gt;&lt;br&gt;&lt;b&gt;failover.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Promote replica, start secondary 2/2, verify links + sentry&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="360" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="f4" value="&lt;font style=&quot;font-size:9.5px;color:#1D4ED8&quot;&gt;CONFIRM_TRAFFIC_SWITCH=secondary&lt;/font&gt;&lt;br&gt;&lt;b&gt;switch-traffic.sh secondary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Atomic ARC flip to secondary (data-plane cutover)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="f5" value="&lt;b&gt;measure.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Print RTO / RPO report from drill-events.log&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1D4ED8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="f6" value="&lt;b&gt;aws rds modify-db-instance --multi-az&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Harden secondary to Multi-AZ (not counted in RTO)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="200" height="90" as="geometry"/></mxCell>

